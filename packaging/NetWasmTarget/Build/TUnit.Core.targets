<?xml version="1.0" encoding="utf-8"?>
<Project>
  <ItemGroup Condition="'$(TUnitImplicitUsings)' == 'true'">
    <Using Include="TUnit.Core.HookType" Static="True" />
    <Using Include="TUnit.Core" />
  </ItemGroup>

  <Target Name="ValidateNetWasmTUnitGenerationMode" BeforeTargets="CoreCompile">
    <Error Condition="'$(TUnitSourceGenerationMode)' != 'ClosedWorldCatalog'"
           Code="NWTUNIT001"
           Text="NetWasm TUnit projects require TUnitSourceGenerationMode=ClosedWorldCatalog." />
  </Target>
</Project>
