<Project>
  <!-- Preserve the fork's defaults, then isolate the three packaging
       projects' restore/intermediate graphs before Microsoft.Common.props. -->
  <Import Project="..\Directory.Build.props" />

  <PropertyGroup>
    <!-- NetWasm packages have their own release line. The upstream TUnit
         version is provenance, not the downstream NuGet package version. -->
    <NetWasmTUnitPackageVersion>0.1.0</NetWasmTUnitPackageVersion>
    <NetWasmTUnitUpstreamVersion>1.68.4</NetWasmTUnitUpstreamVersion>
    <Version>$(NetWasmTUnitPackageVersion)</Version>
    <PackageVersion>$(NetWasmTUnitPackageVersion)</PackageVersion>
    <!-- TUnit's strong-named desktop assemblies intentionally retain the
         upstream 1.0 assembly identity across package releases. TUnit.Engine
         is built from the upstream project and references this identity. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'NetWasm.TUnit.Core'">
    <BaseIntermediateOutputPath>obj/Core/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>obj/Core/</MSBuildProjectExtensionsPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'NetWasm.TUnit.Assertions'">
    <BaseIntermediateOutputPath>obj/Assertions/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>obj/Assertions/</MSBuildProjectExtensionsPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'NetWasm.TUnit.Engine'">
    <BaseIntermediateOutputPath>obj/Engine/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>obj/Engine/</MSBuildProjectExtensionsPath>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Keep embedded deterministic-build document identities independent of
         the checkout root while retaining normal public SourceLink metadata. -->
    <NetWasmTUnitPackageCacheRoot Condition="'$(NUGET_PACKAGES)' != ''">$([System.IO.Path]::GetFullPath('$(NUGET_PACKAGES)'))</NetWasmTUnitPackageCacheRoot>
    <NetWasmTUnitPackageCacheRoot Condition="'$(NetWasmTUnitPackageCacheRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)obj/packages'))</NetWasmTUnitPackageCacheRoot>
    <RestorePackagesPath Condition="'$(NUGET_PACKAGES)' == ''">$(NetWasmTUnitPackageCacheRoot)</RestorePackagesPath>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))=/_/tunit-netwasm,$(NetWasmTUnitPackageCacheRoot)=/_/nuget</PathMap>
  </PropertyGroup>
</Project>
