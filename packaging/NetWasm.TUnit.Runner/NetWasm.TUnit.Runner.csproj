<Project Sdk="NetWasm.Sdk">
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;netwasm0.1</TargetFrameworks>
    <AssemblyName>NetWasm.TUnit.Runner</AssemblyName>
    <RootNamespace>NetWasm.TUnit.Runner</RootNamespace>
    <IsPackable>false</IsPackable>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateRepositoryUrlAttribute>false</GenerateRepositoryUrlAttribute>
    <EnableTUnitSourceGeneration>false</EnableTUnitSourceGeneration>
    <!-- Microsoft.Testing.Platform restores its .NET Standard asset on netwasm0.1. The host calls the request
         context and completion notifier a test host uses, which the platform marks experimental (TPEXP). -->
    <NoWarn>$(NoWarn);NU1701;TPEXP</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Build/NetWasm.TUnit.Program.cs" />
    <!-- The host drives TUnit's engine through Microsoft.Testing.Platform's public abstractions; the program the
         package compiles into each test project passes the engine's factory. -->
    <PackageReference Include="NetWasm.TUnit.Assertions" Version="[$(NetWasmTUnitPackageVersion)]" />
    <PackageReference Include="Microsoft.Testing.Platform" Version="[2.5.2]">
      <ExcludeAssets>Build;Analyzers</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
