<Project Sdk="NetWasm.Sdk">
  <PropertyGroup>
    <!-- net10.0 packs upstream's own build of TUnit.Engine (BuildForkEngine); netwasm0.1 compiles upstream's
         sources here, for the NetWasm host. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;netwasm0.1</TargetFrameworks>
    <AssemblyName>TUnit.Engine</AssemblyName>
    <RootNamespace>TUnit.Engine</RootNamespace>
    <PackageId>NetWasm.TUnit.Engine</PackageId>
    <Authors>Zion Sati</Authors>
    <PackageOwners>Zion Sati</PackageOwners>
    <PackageProjectUrl>https://github.com/zion-sati/TUnit-NetWasm</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zion-sati/TUnit-NetWasm</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Copyright>Copyright (c) Tom Longhurst $(CurrentYear); Copyright (c) 2026 Zion Sati (NetWasm modifications)</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NetWasmTUnitUseRepositoryReadme>false</NetWasmTUnitUseRepositoryReadme>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU5129</NoWarn>
    <SetLinkMetadataAutomatically>false</SetLinkMetadataAutomatically>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'netwasm0.1'">
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SignAssembly>false</SignAssembly>
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netwasm0.1'">
    <Compile Include="..\src\TUnit.Engine\**\*.cs"
             Exclude="..\src\TUnit.Engine\obj\**\*;..\src\TUnit.Engine\bin\**\*" />
    <Compile Include="..\src\TUnit.Core.SourceGenerator\Helpers\GenericMethodInferencePolicy.cs" Link="Discovery\GenericMethodInferencePolicy.cs" />
    <Compile Include="..\src\TUnit.Core.SourceGenerator\Helpers\GenericClassInferencePolicy.cs" Link="Discovery\GenericClassInferencePolicy.cs" />
    <!-- Restored from its .NET Standard asset, as is the TRX abstractions package below. -->
    <PackageReference Include="System.Threading.Channels" Version="[9.0.0]" NoWarn="NU1701" />
  </ItemGroup>
  <Import Project="NetWasmUpstreamSources.props" />

  <ItemGroup>
    <None Update="..\README.md" Pack="false" />
    <None Update="NetWasm.TUnit.Engine\README.md" Pack="true" PackagePath="README.md" Visible="false" />
    <None Include="..\LICENSE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NetWasm.TUnit.Core" Version="[$(NetWasmTUnitPackageVersion)]" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport.Abstractions" Version="[2.5.2]" NoWarn="NU1701">
      <ExcludeAssets>Build;Analyzers</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Testing.Platform" Version="[2.5.2]">
      <ExcludeAssets>Build;Analyzers</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" Version="[2.5.2]" Condition="'$(TargetFramework)' == 'net10.0'">
      <ExcludeAssets>Build;Analyzers</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Package-owned files, emitted once from the outer evaluation. The build props are upstream's
       Microsoft.Testing.Platform hooks, so they apply to net10.0 consumers only. -->
  <ItemGroup Condition="'$(TargetFramework)' == ''">
    <None Include="..\src\TUnit.Engine\TUnit.Engine.props" Pack="true"
          PackagePath="build/net10.0/NetWasm.TUnit.Engine.props" Visible="false" />
    <None Include="..\src\TUnit.Engine\TUnit.Engine.props" Pack="true"
          PackagePath="buildTransitive/net10.0/NetWasm.TUnit.Engine.props" Visible="false" />
    <None Include="$(MSBuildProjectDirectory)\..\src\TUnit.Engine\bin\$(Configuration)\net10.0\TUnit.Engine.dll"
          Pack="true" PackagePath="lib/net10.0/TUnit.Engine.dll" Visible="false" />
    <None Include="$(MSBuildProjectDirectory)\..\src\TUnit.Engine\bin\$(Configuration)\net10.0\TUnit.Engine.xml"
          Pack="true" PackagePath="lib/net10.0/TUnit.Engine.xml" Visible="false" />
  </ItemGroup>

  <Target Name="BuildForkEngine" BeforeTargets="GenerateNuspec" Condition="'$(NoBuild)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\src\TUnit.Engine\TUnit.Engine.csproj"
             Targets="Rebuild"
             Properties="TargetFramework=net10.0;Configuration=$(Configuration);AssemblyVersion=$(AssemblyVersion);BuildProjectReferences=true;GenerateDocumentationFile=true;IsPacking=true" />
  </Target>
</Project>
