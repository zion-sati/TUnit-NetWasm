<Project Sdk="NetWasm.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <PackageId>NetWasm.TUnit.Templates</PackageId>
    <Version>1.66.27-rc.1</Version>
    <PackageVersion>1.66.27-rc.1</PackageVersion>
    <Authors>Zion Sati</Authors>
    <PackageOwners>Zion Sati</PackageOwners>
    <PackageProjectUrl>https://github.com/zion-sati/TUnit-NetWasm</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zion-sati/TUnit-NetWasm</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Copyright>Copyright (c) Tom Longhurst $(CurrentYear); Copyright (c) 2026 Zion Sati (NetWasm modifications)</Copyright>
    <Description>Project template for TUnit tests targeting NetWasm.</Description>
    <PackageTags>tunit;netwasm;testing;wasm;templates;dotnet-new</PackageTags>
    <PackageType>Template</PackageType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NetWasmTUnitUseRepositoryReadme>false</NetWasmTUnitUseRepositoryReadme>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <NoPackageAnalysis>true</NoPackageAnalysis>
  </PropertyGroup>

  <ItemGroup>
    <None Update="..\..\README.md" Pack="false" />
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="content\**\*" Pack="true" PackagePath="content/" />
  </ItemGroup>
</Project>
