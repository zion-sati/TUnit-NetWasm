<Project>
  <!-- netwasm0.1 compiles TUnit's own sources as the .NET 10 code they are. NetWasm's framework is ported from
       .NET, and the netwasm0.1 target defines neither NETSTANDARD nor the NETx_OR_GREATER symbols, so without
       these the sources' conditional code would mix its .NET Standard and its .NET 8 and later halves. The set is
       the one the .NET SDK defines for net10.0. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'netwasm0.1'">
    <DefineConstants>$(DefineConstants);NET;NETCOREAPP;NET5_0_OR_GREATER;NET6_0_OR_GREATER;NET7_0_OR_GREATER;NET8_0_OR_GREATER;NET9_0_OR_GREATER;NET10_0_OR_GREATER;NETCOREAPP1_0_OR_GREATER;NETCOREAPP1_1_OR_GREATER;NETCOREAPP2_0_OR_GREATER;NETCOREAPP2_1_OR_GREATER;NETCOREAPP2_2_OR_GREATER;NETCOREAPP3_0_OR_GREATER;NETCOREAPP3_1_OR_GREATER</DefineConstants>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <!-- TUnit reads its own version from its assembly's metadata, which NetWasm does not keep at run time. The build
       records it as a constant instead. -->
  <Target Name="NetWasmTUnitWriteBuildInfo" BeforeTargets="CoreCompile" Condition="'$(TargetFramework)' == 'netwasm0.1'">
    <PropertyGroup>
      <_NetWasmTUnitBuildInfoFile>$(IntermediateOutputPath)NetWasmBuildInfo.g.cs</_NetWasmTUnitBuildInfoFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(_NetWasmTUnitBuildInfoFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="namespace $(RootNamespace)%3B;internal static class NetWasmBuildInfo { public const string Version = &quot;$(Version)&quot;%3B }" />
    <ItemGroup>
      <Compile Include="$(_NetWasmTUnitBuildInfoFile)" />
      <FileWrites Include="$(_NetWasmTUnitBuildInfoFile)" />
    </ItemGroup>
  </Target>
</Project>
